<div class="hero-section">
    <h1>Find Your Dream Job</h1>
    <p>Browse widely, apply easily.</p>
</div>

<div class="jobs-container">
    <% if (jobs.length> 0) { %>
        <div class="job-grid">
            <% jobs.forEach(job=> { %>
                <div class="job-card">
                    <h3>
                        <%= job.title %>
                    </h3>
                    <div class="job-meta">
                        <span>
                            <%= job.company %>
                        </span> | <span>
                            <%= job.location %>
                        </span>
                    </div>
                    <div class="job-type">
                        <span class="badge">
                            <%= job.type %>
                        </span>
                    </div>
                    <a href="/jobs/<%= job.id %>" class="btn btn-primary">View Details</a>
                </div>
                <% }) %>
        </div>
        <% } else { %>
            <p class="no-jobs">No active job listings found at the moment.</p>
            <% } %>
</div>