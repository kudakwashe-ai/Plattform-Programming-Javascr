<div class="hero-wrapper">
    <div class="container">
        <h1>Find your dream job now</h1>
        <p>JobFlow is the easiest way to get hired. Browse thousands of open positions from top-tier recruiters.</p>
        <div class="search-pill">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" placeholder="Job title, keywords, or company...">
            <button class="btn-search">Search</button>
        </div>
    </div>
</div>

<section class="jobs-section">
    <div class="container">
        <h2 class="section-title">Newest Vacancies</h2>

        <div class="job-grid">
            <% if (jobs.length> 0) { %>
                <% jobs.forEach(job=> { %>
                    <a href="/jobs/<%= job.id %>" class="job-card">
                        <div class="card-header">
                            <div class="logo-icon">
                                <%= job.company.charAt(0).toUpperCase() %>
                            </div>
                            <% if (job.createdAt> new Date(Date.now() - 3 * 24 * 60 * 60 * 1000)) { %>
                                <span
                                    style="font-size: 0.75rem; background: #FEF3C7; color: #B45309; padding: 4px 12px; border-radius: 100px; font-weight: 800;">NEW</span>
                                <% } %>
                        </div>

                        <div class="job-info">
                            <h3>
                                <%= job.title %>
                            </h3>
                            <div class="company-meta">
                                <%= job.company %> • <%= job.location %>
                            </div>
                        </div>

                        <div class="badge-group">
                            <span class="badge-ui badge-blue">
                                <%= job.type.replace('_', ' ' ) %>
                            </span>
                            <span class="badge-ui badge-gray">
                                <%= job.category %>
                            </span>
                            <span class="badge-ui badge-green">Verified</span>
                        </div>

                        <div class="card-footer">
                            <div class="salary-text">
                                <%= new Intl.NumberFormat('en-US', { style: 'currency' , currency: 'USD' ,
                                    maximumFractionDigits: 0 }).format(job.salaryMin).replace(/000$/, 'K' ) %>+
                            </div>
                            <div class="view-link">
                                Details
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </div>
                        </div>
                    </a>
                    <% }) %>
                        <% } else { %>
                            <div
                                style="grid-column: 1/-1; text-align: center; padding: 4rem; color: var(--text-muted);">
                                <h3>No jobs found matching your criteria.</h3>
                            </div>
                            <% } %>
        </div>
    </div>
</section>