<div class="job-details">
    <div class="job-header">
        <h1>
            <%= job.title %>
        </h1>
        <div class="job-company">
            <%= job.company %>
        </div>
        <div class="job-info">
            <span><i class="icon-location"></i>
                <%= job.location %>
            </span>
            <span><i class="icon-type"></i>
                <%= job.type %>
            </span>
            <span><i class="icon-calendar"></i> Posted: <%= job.createdAt.toDateString() %></span>
        </div>

        <% if (user) { %>
            <form action="/jobs/<%= job.id %>/apply" method="POST">
                <button type="submit" class="btn btn-primary btn-lg">Apply Now</button>
            </form>
            <% } else { %>
                <a href="/auth/login" class="btn btn-primary btn-lg">Login to Apply</a>
                <% } %>
    </div>

    <hr>

    <div class="job-description">
        <h2>Description</h2>
        <div class="content">
            <%- job.description %>
        </div>
    </div>

    <div class="job-requirements">
        <h2>Requirements</h2>
        <div class="content">
            <%- job.requirements %>
        </div>
    </div>
</div>