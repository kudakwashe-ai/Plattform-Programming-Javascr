<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Clean App</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
</head>

<body>
    <header>
        <nav>
            <div class="container">
                <h1 class="logo">Clean App</h1>
                <ul class="nav-links">
                    <li><a href="/">Home</a></li>
                    <li><a href="/users">Users API</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="container">
        <div class="error-page">
            <h1>❌ Error</h1>
            <h2>
                <%= message %>
            </h2>
            <% if (error.status) { %>
                <p class="error-status">Status: <%= error.status %>
                </p>
                <% } %>

                    <% if (error.stack) { %>
                        <div class="error-stack">
                            <h3>Stack Trace:</h3>
                            <pre><%= error.stack %></pre>
                        </div>
                        <% } %>

                            <div class="error-actions">
                                <a href="/" class="btn">Go Home</a>
                            </div>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> Clean App. Built with Express + Prisma v6 + MongoDB</p>
        </div>
    </footer>
</body>

</html>