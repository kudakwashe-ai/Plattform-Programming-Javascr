<!DOCTYPE html>
<html>

<head>
    <title>User List</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
</head>

<body>
    <h1>User List</h1>
    <a href="/register">Add New User</a>
    <ul>
        <% users.forEach(function(user) { %>
            <li>
                <%= user.name %> (<%= user.email %>)
            </li>
            <% }); %>
    </ul>
</body>

</html>